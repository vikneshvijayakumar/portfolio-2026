---
// Canvas landing — the Fignam-Codex pan/zoom canvas home, ported as a React
// island with the site theme (IBM Plex fonts, indigo accent). Standalone head:
// the canvas ships its own stylesheet, so it doesn't load global.css.
import "../styles/fonts.css";
import "../canvas/styles.css";
import "../styles/header.css";
import "../styles/glow.css";
import "../styles/made-with.css";
import CanvasApp from "../canvas/CanvasApp";
import ThemeInit from "../components/ThemeInit.astro";

const title = "Viknesh Vijayakumar — Lead Product Designer";
const description =
  "Lead Product Designer with 12 years of experience designing complex enterprise software, from healthcare AI and edtech to client work across domains.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <ThemeInit />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <!-- Self-hosted (see styles/fonts.css) — preload so text doesn't wait on CSS parse. -->
    <link rel="preload" href="/fonts/plex-sans-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-serif-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <CanvasApp client:only="react" />
    <script>
      // Records this page as "home", so a case study's Back returns to the
      // canvas rather than the classic landing. Camera position is restored
      // separately by CanvasApp.
      import { initLanding } from "../scripts/landing-return";
      initLanding();
    </script>
  </body>
</html>
