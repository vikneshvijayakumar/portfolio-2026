  <script>
    import { autoCarousel } from "../scripts/auto-carousel";

    // Scroll position is the state — no active index to keep in sync, and the
    // browser already does the swiping, so autoplay only has to nudge it on.
    document
      .querySelectorAll<HTMLElement>("[data-asx-carousel]")
      .forEach((wrap) => {
        const row = wrap.querySelector<HTMLElement>(".asx-carousel");
        if (!row) return;
        const advance = (delta: number) => {
          const slides = [...row.children] as HTMLElement[];
          // Pitch off the slides themselves, so the row's gap is in it.
          const step = slides[1].offsetLeft - slides[0].offsetLeft;
          const at = Math.round(row.scrollLeft / step) + delta;
          row.scrollTo({
            left: ((at + slides.length) % slides.length) * step,
            behavior: "smooth",
          });
        };

        const start = autoCarousel(wrap, advance, { swipe: false });

        wrap
          .querySelector("[data-asx-previous]")
          ?.addEventListener("click", () => {
            advance(-1);
            start();
          });
        wrap.querySelector("[data-asx-next]")?.addEventListener("click", () => {
          advance(1);
          start();
        });
      });
  </script>
