---
import CaseStudyLayout from "../layouts/CaseStudyLayout.astro";
import CaseStudyFooter from "../components/CaseStudyFooter.astro";
import FlowWalkthrough from "../components/FlowWalkthrough.astro";
import CompareTabs from "../components/CompareTabs.astro";
import { previousSvg, nextSvg, fullscreenSvg } from "../case-studies/shared";
import SheetCompare from "../components/SheetCompare.astro";
import "../case-studies/study-aistylist.css";

const FACTS = [
  { label: "Role", value: "Lead Product Designer" },
  { label: "Type", value: "Product redesign" },
  { label: "Timeline", value: "8 weeks" },
  { label: "Platform", value: "iOS, Android, Responsive Web" },
  {
    label: "Skills",
    value:
      "UX audit, information architecture, user flows, high fidelity UI, handoff",
  },
];

const CRITERIA = [
  {
    title: "Time to first recommendation",
    body: "Median time from first open to the first personalized look. The primary activation metric, and the one I made every structural decision against.",
  },
  {
    title: "Funnel step conversion",
    body: "Completion rate for each step of onboarding, sign in and the style assessment, instrumented individually so drop off could be pinned to a screen.",
  },
  {
    title: "Paywall view to trial start",
    body: "Conversion at the new plan screen, with the old placement kept as the baseline. The test of whether moving the subscription earlier was right.",
  },
  {
    title: "Feature reach and repeat sessions",
    body: "Share of activated users touching wardrobe, saved looks and the attire switch, read against day seven and day thirty return rate.",
  },
];

// Activation walkthrough. Tap points are fractions of the frame: every primary
// CTA sits centred at 91% down, except the Google button on Create Account.
const S = "/assets/aistylist/";
const CTA = { x: 0.5, y: 0.91 };

// The old path to the same place: nine screens, two of them pure data entry.
const ACTIVATION_OLD = [
  { img: `${S}old_01_splash.webp`, hold: 1400 },
  { img: `${S}old_02_onboarding.webp`, tap: { x: 0.459, y: 0.916 } },
  {
    img: `${S}old_03_login.webp`,
    tap: { x: 0.725, y: 0.899 },
    note: "Social sign in sits under the form, so most people type an email and password anyway.",
    noteAt: { x: 0.28, y: 0.83 },
  },
  {
    img: `${S}old_04_signup_empty.webp`,
    tap: { x: 0.5, y: 0.365 },
    note: "Registration first: three fields and a checkbox before the app has said what it does.",
    noteAt: { x: 0.05, y: 0.45 },
  },
  { img: `${S}old_05_signup_filled.webp`, tap: { x: 0.5, y: 0.664 } },
  {
    img: `${S}old_06_verification.webp`,
    tap: { x: 0.5, y: 0.552 },
    note: "Then an email round trip, still before the app has shown a single recommendation.",
    noteAt: { x: 0.05, y: 0.436 },
  },
  { img: `${S}old_07_onboarding.webp`, tap: { x: 0.5, y: 0.916 } },
  {
    img: `${S}old_08_personal.webp`,
    tap: { x: 0.508, y: 0.795 },
    note: "Six more fields on a screen of their own, because sign up only ever captured an email.",
    noteAt: { x: 0.05, y: 0.35 },
  },
  {
    // Last screen of the flow: nothing to press, it just holds and restarts.
    img: `${S}old_09_profile.webp`,
    hold: 3600,
    note: "And the assessment still does not start. It waits in a list as the only row that works, beside details just submitted, two empty wardrobes, and payment.",
    noteAt: { x: 0.05, y: 0.533 },
  },
];

const ACTIVATION_NEW = [
  { img: `${S}01_splash.webp`, hold: 1400 },
  { img: `${S}10_welcome.webp`, tap: CTA },
  {
    // One card stands in for the five: the point is that onboarding explains
    // the app first, and that Skip is there for anyone who doesn't want it.
    img: `${S}02_onboarding1.webp`,
    tap: { x: 0.893, y: 0.095 },
    // Just clear of the Skip label, so the leader does not run across it.
    note: "Onboarding explains what the app does before asking for anything, and Skip is always there.",
    noteAt: { x: 0.96, y: 0.095 },
  },
  {
    img: `${S}07_create_account.webp`,
    tap: { x: 0.5, y: 0.542 },
    note: "Social sign in populates name and email, so no screen has to ask for them.",
    noteAt: { x: 0.05, y: 0.542 },
  },
  {
    // Last screen of the flow: nothing to press, it just holds and restarts.
    img: `${S}11_style_profile_landing.webp`,
    hold: 3600,
    note: "Filled from the social sign in. A nickname and not a name, because what people put on social media often is not their own.",
    noteAt: { x: 0.22, y: 0.38 },
  },
];

// Plan outfit, old against new. The old path runs through six screens with no
// sense of progress; the new one is a checklist that states it.
const PLAN_OLD = [
  {
    img: `${S}pl_old_1_wardrobe.webp`,
    tap: { x: 0.5, y: 0.705 },
    note: "The old landing page is an empty wardrobe with a search field, so planning an outfit starts by working out where it starts.",
    noteAt: { x: 0.06, y: 0.28 },
  },
  { img: `${S}pl_old_2_category.webp`, tap: { x: 0.5, y: 0.438 } },
  {
    img: `${S}pl_old_4_tops.webp`,
    tap: { x: 0.913, y: 0.15 },
    note: "A flat grid of everything, with no way to tell a suggestion from a filter result.",
    noteAt: { x: 0.06, y: 0.3 },
  },
  {
    img: `${S}pl_old_3_filters.webp`,
    tap: { x: 0.72, y: 0.951 },
    note: "Six filter dimensions to work through before a single garment is chosen.",
    noteAt: { x: 0.06, y: 0.37 },
  },
  // The same grid again: applying the filters returns you to where you started,
  // which is the repetition the redesign removes.
  { img: `${S}pl_old_4_tops.webp`, tap: { x: 0.26, y: 0.297 } },
  {
    // Last screen of the flow: nothing to press, it just holds and restarts.
    img: `${S}pl_old_6_combination.webp`,
    hold: 3600,
    note: "Six screens in, and nothing has said how far along you are or when this ends.",
    noteAt: { x: 0.06, y: 0.32 },
  },
];

const PLAN_NEW = [
  {
    img: `${S}ret_dashboard.webp`,
    tap: { x: 0.5, y: 0.283 },
    note: "The new landing page is a personalized dashboard: recommended and saved outfits, the weather, and one primary action. Planning an outfit starts from it.",
    noteAt: { x: 0.94, y: 0.18 },
  },
  { img: `${S}pl_new_1_settype.webp`, tap: { x: 0.5, y: 0.935 } },
  {
    img: `${S}pl_new_2_empty.webp`,
    tall: true,
    tap: { x: 0.5, y: 0.378 },
    note: "One checklist. Every piece of the outfit, and everything still missing, on one screen.",
    noteAt: { x: 0.94, y: 0.2 },
  },
  {
    img: `${S}pl_new_3_tops.webp`,
    tap: { x: 0.27, y: 0.496 },
    note: "The filters are gone. The grid is for choosing, not for tuning.",
    noteAt: { x: 0.94, y: 0.22 },
  },
  {
    img: `${S}pl_new_4_half.webp`,
    tall: true,
    tap: { x: 0.5, y: 0.66 },
    note: "Forty percent, stated. The end of the flow is visible from the start of it.",
    noteAt: { x: 0.86, y: 0.2 },
  },
  {
    // Last screen of the flow: nothing to press, it just holds and restarts.
    img: `${S}pl_new_5_complete.webp`,
    tall: true,
    hold: 3600,
    note: "Completion is a state the flow actually reaches, and says so.",
    noteAt: { x: 0.9, y: 0.2 },
  },
];

// Payment, old against new. One comparison, so the tab bar hides itself.
const PAYMENT_TABS = [
  {
    label: "Payment",
    old: {
      // The same screen twice: confirming the outfit is what raises the sheet,
      // so the loop plays that rather than showing the result on its own.
      img: `${S}pl_old_6_combination.webp`,
      swap: `${S}pay_old_sheet.webp`,
      tap: { x: 0.735, y: 0.931 },
      // Off the sheet, over the dimmed outfit: tapping there is how it closes.
      dismiss: { x: 0.5, y: 0.32 },
      alt: "Confirming the chosen outfit raises the old subscription sheet over it",
      note: "Nine screens into the outfit flow, confirming the outfit raises a sheet. Two prices for the same unnamed thing, and nothing yet to want it for.",
    },
    new: {
      // The assessment result leads, because where the plans appear is the
      // point: tapping through from the finished profile opens Premium, then
      // Lite. All three are exported at the phone's own aspect, so nothing here
      // scrolls or gets cropped.
      img: `${S}as_new_04_complete.webp`,
      swap: [`${S}pay_new_premium.webp`, `${S}pay_new_lite.webp`],
      tap: { x: 0.5, y: 0.935 },
      // Back, top left of the plan screen: the loop returns the way it came in.
      dismiss: { x: 0.07, y: 0.09 },
      alt: "The finished style profile, then the two named subscription plans",
      note: "Straight after the assessment result, where the value has just been shown. Two named plans, priced against each other, with what each buys listed under them.",
    },
  },
];

// The three problem/solution sections, each its own stage of the journey.
const FLOWS = [
  {
    id: "asx-activation",
    num: "03",
    nav: "Activation",
    eyebrow: "Activation",
    title: "Onboarding and sign in",
    problem: [
      "A new user was asked to register, verify, and then describe themselves before they even knew what the app was about or what they'd get from using it.",
    ],
    changed: [
      "First explain what the app does and then have the user sign in with their social media account, which covers most of the registration details. Shorten the distance to first recommendation by collecting only the minimal info required for the styling engine.",
    ],
  },
  {
    id: "asx-conversion",
    num: "05",
    nav: "Conversion",
    eyebrow: "Conversion",
    title: "Payment flow",
    problem: [
      "Subscription was presented as an add-on feature after the assessment, which wasn't a great sales pitch.",
    ],
    changed: [
      "Completing the assessment is a milestone in itself, and that's when the user is more likely to be willing to pay. This was a big bet, and I recommended we test it.",
    ],
  },
  {
    id: "asx-engagement",
    num: "06",
    nav: "Engagement",
    eyebrow: "Engagement",
    title: "Landing page and plan outfit",
    problem: [
      "When the app opened, I'd see an empty wardrobe, which didn't help me understand what the app did. When planning the outfit, there was no sense of how much you'd accomplished or what was left to do, and you had to answer questions that you already answered.",
    ],
    changed: [
      "I changed this with a dashboard that gives you a clear place to start. There's recommended styled outfits that you can look through or use the prominently placed CTA for a fresh new start. I also added a checklist to outfit choosing part to show the status, what's missing and what's coming up. I also removed the extra filters as they accomplished",
    ],
  },
];

// The four assessment decisions, old against new. Anchors are fractions of the
// frame: the old note points in from the left, the new note in from the right.
const ASSESSMENT_TABS = [
  {
    label: "Route",
    old: {
      img: `${S}as_01_route.webp`,
      alt: "Assessment route selection, with the AI assisted and manual paths given equal weight",
      note: "Two routes given equal weight, so the first decision is about how to answer rather than answering.",
    },
    new: {
      img: `${S}as_new_01_landing.webp`,
      alt: "New skin tone landing, leading with the selfie and demoting manual entry to a link",
      note: "One route leads. Entering details by hand is still there, one line down, for anyone who wants it.",
    },
  },
  {
    label: "Photo rules",
    old: {
      img: `${S}as_02_selfie_rules.webp`,
      swap: `${S}as_02_body_rules.webp`,
      alt: "Eight rules before the selfie, then five more before the full body photo",
      note: "Eight rules before the selfie and five more before the full body shot, written like a passport photo checklist.",
    },
    new: {
      img: `${S}as_new_02_selfie.webp`,
      swap: `${S}as_new_02_body.webp`,
      alt: "New selfie and body setup, each a short plainly worded list on a sheet over the camera",
      note: "Still two screens. The wording turned into help rather than requirements, and it sits on the camera where the photo is taken.",
    },
  },
  {
    label: "Skin tone",
    old: {
      img: `${S}as_03_skintone.webp`,
      overlay: `${S}as_03_popup.webp`,
      tap: { x: 0.81, y: 0.327 },
      alt: "Skin tone question, with each definition hidden behind its own info icon",
      note: "Each definition sat behind its own info icon, one popup at a time, so choosing became a memory test.",
    },
    new: {
      img: `${S}as_new_03_skintone.webp`,
      alt: "New skin tone selection with every description visible beside its swatch",
      note: "Every description visible at once, beside its swatch, so the choice becomes a comparison.",
    },
  },
  {
    label: "Result",
    old: {
      img: `${S}as_04_opening.webp`,
      alt: "The assessment result, laid out as a filled in form in a different visual language",
      note: "The result read as a submitted form, in a visual language belonging to no other screen in the app.",
    },
    new: {
      img: `${S}as_new_04_complete.webp`,
      alt: "New style profile complete screen, presenting the result as a profile",
      note: "The same data presented as the beginning of something, in the language of the rest of the app.",
    },
  },
];

// The six documented parts, as the sheets themselves — every value drawn for
// both themes on one sheet, so the split slider shows the pair at once.
const SYSTEM_SHEETS = [
  {
    label: "Colour",
    light: "/assets/aistylist/sys_1_colors_light.webp",
    dark: "/assets/aistylist/sys_1_colors_dark.webp",
    caption:
      "A purple primary and secondary, four semantic states tuned to sit beside them, a six step grey ramp and two gradients.",
  },
  {
    label: "Headings",
    light: "/assets/aistylist/sys_2_headings_light.webp",
    dark: "/assets/aistylist/sys_2_headings_dark.webp",
    caption:
      "Clash Display for headings at six sizes from 56 down to 20, each with its line height as a ratio rather than a pixel value.",
  },
  {
    label: "Body",
    light: "/assets/aistylist/sys_3_body_light.webp",
    dark: "/assets/aistylist/sys_3_body_dark.webp",
    caption:
      "Fustat for body at eight sizes from 40 down to 12, in two weights.",
  },
  {
    label: "Icons & spacing",
    light: "/assets/aistylist/sys_4_icons_spacing_light.webp",
    dark: "/assets/aistylist/sys_4_icons_spacing_dark.webp",
    caption:
      "Around thirty interface icons, plus five custom body shape icons drawn for this product, on a ten step spacing scale from 8 to 120.",
  },
  {
    label: "Text fields",
    light: "/assets/aistylist/sys_5_textfields_light.webp",
    dark: "/assets/aistylist/sys_5_textfields_dark.webp",
    caption:
      "Five field configurations plus a text area, each with label, hint and status, and three input states.",
  },
  {
    label: "Buttons",
    light: "/assets/aistylist/sys_6_buttons_light.webp",
    dark: "/assets/aistylist/sys_6_buttons_dark.webp",
    caption:
      "Three sizes, with padding and icon gap set against the label size so a developer scaling one does not have to ask.",
  },
  {
    label: "Button variants",
    light: "/assets/aistylist/sys_7_button_variants_light.webp",
    dark: "/assets/aistylist/sys_7_button_variants_dark.webp",
    caption:
      "Twelve variants across text, icon with text and icon only, each drawn for default, hover, active and disable.",
  },
];

// Counted off the Figma files, not measured off users — see the section intro.
const METRICS = [
  {
    old: "28",
    now: "17",
    what: "Interactions from launch to the first result",
    body: "Counted along the default email sign up and image based assessment. The new flow takes the default social sign up, adds six onboarding screens, and still gets there in 17. That's 40% lesser interations than before",
  },
  {
    old: "14",
    now: "4",
    what: "Things the user has to supply before the result",
    body: "Pieces of information collected before a result is shown, sign up included. The new path asks for four: an everyday vibe, a selfie, a full length photo, and consent to capture them.",
  },
  {
    old: "9",
    now: "1",
    what: "Screens between the result and the price",
    body: "The old app presented the subscription after 9 screens in the outfit flow. Now it comes right after the assessment.",
  },
  {
    old: "6",
    now: "0",
    what: "Filters standing between the user and an outfit",
    body: 'There were 6 filters between the user and the outfit. I replaced them with "in progress", "partial", and "complete" states. The old flow had no such indicators.',
  },
];

const OUTCOMES = [
  {
    title: "Improved time to value",
    body: "By reducing friction during setup, users receive meaningful recommendations faster and with less effort. Read on median time to first recommendation.",
  },
  {
    title: "Better feature discoverability",
    body: "Important functionality is accessible when the users need it, without needing to search. Read on the share of activated users reaching wardrobe, saved looks and the attire switch.",
  },
  {
    title: "Improved monetization flow",
    body: "Subscription plans are introduced earlier, right after users experience personalized value. Tested as paywall view to trial start, against the old placement.",
  },
  {
    title: "Stronger personalization",
    body: "The connection between assessment answers and how they affect recommendations is visible throughout the app. Read on repeat sessions at day seven and day thirty.",
  },
];

const NAV_SECTIONS = [
  { id: "asx-hero", label: "Intro" },
  { id: "asx-overview", label: "Overview" },
  { id: "asx-audit", label: "Audit" },
  { id: "asx-activation", label: "Activation" },
  { id: "asx-assessment", label: "Assessment" },
  { id: "asx-conversion", label: "Conversion" },
  { id: "asx-engagement", label: "Engagement" },
  { id: "asx-assistant", label: "Sia" },
  { id: "asx-retention", label: "Retention" },
  { id: "asx-platform", label: "Platform" },
  { id: "asx-handoff", label: "Handoff" },
  { id: "asx-counted", label: "Outcomes" },
  { id: "asx-outcomes", label: "What Next?" },
  { id: "asx-reflection", label: "Reflection" },
];
---

<CaseStudyLayout
  title="AI Stylist Case Study | Viknesh Vijayakumar"
  description="Redesigning a consumer AI styling app so users reach their first meaningful recommendation faster, across iOS, Android and responsive web."
  ogImage="/assets/aistylist.webp"
>
  <div
    class="cs-overlay cs-overlay--asx"
    role="dialog"
    aria-modal="true"
    aria-label="AI Stylist case study"
  >
    <div class="cs-topbar">
      <a class="cs-back" href="/" aria-label="Back to the portfolio">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span>Back</span>
      </a>
      <div class="cs-topbar__title">
        <span class="cs-topbar__eyebrow">Freelance · 2025</span>
        <span class="cs-topbar__name">AI Stylist</span>
      </div>
    </div>

    <nav class="cs-sidenav" aria-label="Sections">
      {
        NAV_SECTIONS.map((s) => (
          <a href={`#${s.id}`} class={s.id === "asx-hero" ? "is-active" : ""}>
            {s.label}
          </a>
        ))
      }
    </nav>

    <div class="cs-scroll">
      <section id="asx-hero" class="cs-hero">
        <div class="cs-hero__inner">
          <div class="cs-hero__main">
            <div class="cs-hero__lede">
              <h1 class="cs-hero__title">
                Getting an AI stylist app out of <em>its own way</em>.
              </h1>
              <p class="cs-hero__desc">
                Recently, I worked on an AI powered fashion styling app that
                reduces decision fatigue and builds personalized wardrobes
                curated on the user's physical attributes. The recommendation
                engine was their core value proposition. Users had to complete
                several steps before they even knew what they would get.
              </p>
              <div class="cs-scroll-hint">Scroll to explore</div>
            </div>
            <div class="cs-hero__meta">
              {
                FACTS.map((f) => (
                  <div class="cs-meta-item">
                    <>
                      <span class="cs-meta-label">{f.label}</span>
                      <span class="cs-meta-val">{f.value}</span>
                    </>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section id="asx-overview" class="cs-section cs-section--challenge">
        <div class="cs-section__inner">
          <div class="cs-section__number">01<span>Overview</span></div>
          <div>
            <div class="cs-heading-body-group">
              <h2 class="cs-heading">
                A consumer app plays by different rules
              </h2>
              <p class="cs-body">
                Most of my experience is in enterprise SaaS and healthcare where
                users are trained, and won't leave a workflow because a screen
                annoyed them. But, for consumer apps, this is the opposite.
                People download it on a whim and get rid of it after just one
                minute if they're not satisfied. In enterprise I am reducing
                error and cognitive load across a long session. Here I had to
                shorten the distance to the first useful output, make the app
                less overwhelming and get the user to open it again. Here's how
                the app worked.
              </p>
            </div>
            <div class="cs-outcomes-grid" data-reveal-stagger>
              <div class="cs-outcome-card">
                <div class="cs-outcome-card__icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="48"
                    height="48"
                    fill="none"
                    viewBox="0 0 64 64"
                    aria-hidden="true"
                  >
                    <path
                      fill="var(--cs-accent)"
                      fill-rule="evenodd"
                      d="M32 34.667a8.667 8.667 0 1 0 0-17.334 8.667 8.667 0 0 0 0 17.334Zm16.11 6.794.591.283A19.334 19.334 0 0 1 32 51.334a19.334 19.334 0 0 1-16.701-9.59l.592-.282a37.44 37.44 0 0 1 16.106-3.62c5.76 0 11.227 1.3 16.112 3.62Z"
                      clip-rule="evenodd"></path>
                    <path
                      fill="var(--cs-accent)"
                      opacity="0.3"
                      fill-rule="evenodd"
                      d="M32 2C15.432 2 2 15.432 2 32c0 16.568 13.432 30 30 30 16.568 0 30-13.432 30-30a30.223 30.223 0 0 0-.6-5.997l-6.533 1.328A23.334 23.334 0 1 1 32 8.667a23.2 23.2 0 0 1 14.379 4.954l-3.712 3.712L45.333 20h12V8l-2.666-2.667L51.12 8.88A29.867 29.867 0 0 0 32 2Z"
                      clip-rule="evenodd"></path>
                  </svg>
                </div>
                <h4>Create an Account</h4>
                <p>
                  Create an account using email and password or signup with a
                  social media account.
                </p>
              </div>

              <div class="cs-outcome-card">
                <div class="cs-outcome-card__icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="48"
                    height="48"
                    fill="none"
                    viewBox="0 0 64 64"
                    aria-hidden="true"
                  >
                    <g clip-path="url(#cs-icon-roadmap-clip)">
                      <path
                        fill="var(--cs-accent)"
                        opacity="0.3"
                        fill-rule="evenodd"
                        d="M4.571 4.571a4.571 4.571 0 1 0 0 9.143h44.572a5.715 5.715 0 0 1 0 11.429H16A16.002 16.002 0 0 0 1.218 47.266 16 16 0 0 0 16 57.143h34.286v4.571a2.286 2.286 0 0 0 3.904 1.614l9.143-9.143a2.286 2.286 0 0 0 0-3.232L54.19 41.81a2.286 2.286 0 0 0-3.904 1.618V48H16a6.857 6.857 0 0 1 0-13.714h33.143a14.857 14.857 0 1 0 0-29.715H4.57Z"
                        clip-rule="evenodd"></path>
                      <path
                        fill="var(--cs-accent)"
                        fill-rule="evenodd"
