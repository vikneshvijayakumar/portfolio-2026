---
import fs from "node:fs";
import { fileURLToPath } from "node:url";
import CaseStudyLayout from "../layouts/CaseStudyLayout.astro";
import CaseStudyFooter from "../components/CaseStudyFooter.astro";
import { FLOW_ICONS } from "../case-studies/cs-flow-icons";
import { previousSvg, nextSvg, fullscreenSvg } from "../case-studies/shared";
import step1Questionnaire from "../assets/step1-questionnaire.webp";
import step2ResponseCodes from "../assets/step2-response codes.webp";
import step3CreatePdf from "../assets/step3-createpdf.webp";
import step4OutputEntry from "../assets/step4-outputentry.webp";
import initialExploration from "../assets/initial-exploration.webp";
import initialVersion1 from "../assets/initialversion1.webp";
import initialVersion2 from "../assets/initialversion2.webp";
import responsemapping from "../assets/responsemapping.webp";
import "../case-studies/study-output-builder.css";

const EXPLORATION_IMAGES = [
  {
    image: initialExploration,
    alt: "Initial visual design exploration of the output builder canvas",
  },
  {
    image: initialVersion1,
    alt: "First visual layout builder version featuring columns and styles presets",
  },
  {
    image: initialVersion2,
    alt: "Theme presets and typography configurations editor panel mockup",
  },
];

const NAV_SECTIONS = [
  { id: "cs-overview", label: "Overview" },
  { id: "cs-origin", label: "Origin" },
  { id: "cs-problem", label: "Problem" },
  { id: "cs-constraint", label: "Constraint" },
  { id: "cs-datamodel", label: "Mapping Model" },
  { id: "cs-firstversion", label: "First version" },
  { id: "cs-concerns", label: "Scoping" },
  { id: "cs-solution", label: "Solution" },
  { id: "cs-impact", label: "Impact" },
  { id: "cs-evolution", label: "Next" },
  { id: "cs-reflection", label: "Reflection" },
];

const FLOW = [
  {
    title: "Questionnaire",
    desc: "A form is created by an admin, sometimes with 50+ fields, and then exported for output setup.",
    image: step1Questionnaire,
    alt: "Questionnaire editor with the Distance Learning Form questions listed",
  },
  {
    title: "Generate Codes",
    desc: "The system generates a unique response code for every element, so a single question can have many response codes.",
    image: step2ResponseCodes,
    alt: "Exported questionnaire data showing response codes for each question",
  },
  {
    title: "PDF & code mapping",
    desc: "The PDF template is built manually, and the response codes are mapped to the correct field.",
    image: step3CreatePdf,
    alt: "PDF builder with a response code manually entered for a selected field",
  },
  {
    title: "Upload & test",
    desc: "The template is uploaded. If a response code is wrong, the PDF is edited and uploaded again, until everything is right.",
    image: step4OutputEntry,
    alt: "Output entry screen for uploading and configuring the Distance Learning Contract PDF",
  },
];

// Figures are dropped into public/assets/output-builder/ as they get produced.
// Render only what exists so a missing file never ships as a broken image.
const hasAsset = (p: string) =>
  fs.existsSync(fileURLToPath(new URL(`../../public${p}`, import.meta.url)));

const V1_FIGURES = [
  {
    src: "/assets/output-builder/v1-field-picker.png",
    alt: "First version of the output builder showing form fields imported by name, a builder style toggle, and a layout picker",
    caption:
      "v1. Fields imported by name, with a builder style toggle and a layout picker.",
  },
  {
    src: "/assets/output-builder/v1-section-controls.png",
    alt: "First version section controls panel with column count, linked and unlinked padding, and column gap settings",
    caption:
      "v1. Granular section controls: columns, linked and unlinked padding, column gap.",
  },
  {
    src: "/assets/output-builder/v1-theme.png",
    alt: "First version theme panel with color swatches and typography controls, close to a full design tool",
    caption:
      "v1. Theme, color, and typography controls. Close to a full design tool.",
  },
];

const LEGACY_FIGURE = {
  src: "/assets/output-builder/legacy-output-flow.webp",
  alt: "Diagram of the legacy output flow, showing a form's output pointing at a template built in a separate PDF tool and pasted back field by field",
  caption:
    "The legacy path. A form's output pointed at a template built in a separate PDF tool, then pasted back field by field. The notes mark where the manual work lived.",
};

const CONSTRAINTS_FIGURE = {
  src: "/assets/output-builder/stakeholder-constraints.png",
  alt: "Annotated screen of the initial builder exploration with consolidated stakeholder feedback marked across it",
  caption:
    "Feedback from across the teams on the first version. Two questions stayed open: whether a multiple choice answer shows only the selected option, and whether fields sit in one column or two.",
};

const CONCERNS = [
  {
    team: "Stakeholders",
    worry:
      "The drag & drop will confuse the admins. Not everyone using this will be technical.",
    color: "yellow",
    outcome:
      "I kept a manual way to add fields along with drag and drop. The visual builder became the default, and the PDF route stayed for legacy users.",
  },
  {
    team: "Engineers",
    worry:
      "An open ended layout builder will be painful to build and worse to maintain",
    color: "blue",
    outcome:
      "I narrowed the customization to a small set of choices that still covered the variation organizations needed.",
  },
  {
    team: "Backend engineers",
    worry: "The new response mapping will be a challenge to implement",
    color: "purple",
    outcome:
      "I worked with the frontend engineers to confirm the mapping could be handled entirely on the frontend, with little to no extra backend work.",
  },
  {
    team: "Sales and support",
    worry:
      "Customers keep asking why implementation takes so long. They will love this!",
    color: "green",
    outcomeLabel: "What it told me",
    outcome:
      "The people closest to the customer already knew it was worth fixing.",
  },
];

const FEATURES = [
  {
    title: "Automated code mapping",
    body: "Users pick form questions from a plain language list, in the words they already know. The system wires up the response codes in the background, so nobody sees or types one.",
    helps: [
      "Less cognitive load",
      "No memorization of codes",
      "Fewer mapping errors",
      "Easier for new users to pick up",
    ],
    videoPath: "/assets/output-builder/work-with-data.mp4",
    duration: "0:17",
    caption: "Picking questions by name.",
  },
  {
    title: "Visual builder",
    body: "Template creation moved inside the product. Like Google Forms or Microsoft Forms, users drag and drop, only here they drag form questions onto the canvas and see the output as they build. A manual way to add questions stays alongside for admins who prefer it.",
    helps: [
      "Users can now see the output as they build",
      "No need to switch between the app and PDF tools",
      "Instant updates",
    ],
    videoPath: "/assets/output-builder/drag-and-drop.mp4",
    duration: "0:11",
    caption:
      "Dragging fields onto the canvas and watching the output update live as the template is built, all inside the product.",
  },
  {
    title: "Compact or Comfortable",
    body: "Users pick a compact or comfortable view, and the system arranges the fields on its own. The output still adapts to each form.",
    helps: [
      "No layout decisions to make",
      "The system arranges the fields",
      "Consistent outputs across forms",
    ],
    videoPath: "/assets/output-builder/flexible-customization.mp4",
    duration: "0:13",
    caption: "Switching between the two views.",
  },
  {
    title: "Org Defaults",
    body: "Most organizations rebuilt the same headers and layouts for every template. Now each org has a default template with its header fields set once, so users start from it and only work on the form questions.",
    helps: [
      "Faster setup",
      "Reduces repetitive work",
      "Ensures consistency",
      "Better control for organizations",
    ],
    videoPath: "/assets/output-builder/smart-defaults.mp4",
    duration: "0:19",
    caption:
      "Starting from a saved organization default and filling in only the form fields, instead of rebuilding headers and layout each time.",
  },
];

const chevronSvg =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>';

const checkSvg =
  '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 8.5 6.5 12 13 5" /></svg>';
const pauseSvg =
  '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>';
const playSvg =
  '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.2v13.6a1 1 0 0 0 1.53.85l10.5-6.8a1 1 0 0 0 0-1.7l-10.5-6.8A1 1 0 0 0 8 5.2Z" /></svg>';
---

<CaseStudyLayout
  title="Output Builder Case Study | Viknesh Vijayakumar"
  description="How one question about a legacy .NET constraint turned a PDF editor request into a workflow redesign, and cut template creation from days to hours."
  ogImage="/assets/output-builder.webp"
>
  <div
    class="cs-overlay cs-overlay--obv"
    role="dialog"
    aria-modal="true"
    aria-label="Output Builder case study"
  >
    <div class="cs-topbar">
      <a class="cs-back" href="/" aria-label="Back to the portfolio">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span>Back</span>
      </a>
      <div class="cs-topbar__title">
        <span class="cs-topbar__eyebrow">Empyra · 2024</span>
        <span class="cs-topbar__name">Output Builder</span>
      </div>
    </div>

    <nav class="cs-sidenav" aria-label="Sections">
      {
        NAV_SECTIONS.map((s) => (
          <a href={`#${s.id}`} class={s.id === "cs-hero" ? "is-active" : ""}>
            {s.label}
          </a>
        ))
      }
    </nav>

    <div class="cs-scroll">
      <section id="cs-hero" class="cs-hero">
        <div class="cs-hero__inner">
          <div class="cs-hero__main">
            <div class="cs-hero__lede">
              <h1 class="cs-hero__title">
                The legacy workaround we almost rebuilt in React
              </h1>
              <p class="cs-hero__desc">
                How one question about a legacy .NET constraint turned a PDF
                editor request into a workflow redesign, and cut template
                creation from days to hours.
              </p>
              <div class="cs-scroll-hint">Scroll to explore</div>
            </div>
            <div class="cs-hero__meta">
              <div class="cs-meta-item">
                <span class="cs-meta-label">Role</span><span class="cs-meta-val"
                  >Solo Designer</span
                >
              </div>
              <div class="cs-meta-item">
                <span class="cs-meta-label">Outcomes</span><span
                  class="cs-meta-val">90% faster template creation</span
                >
              </div>
              <div class="cs-meta-item">
                <span class="cs-meta-label">Type</span><span class="cs-meta-val"
                  >Workflow Redesign</span
                >
              </div>
              <div class="cs-meta-item">
                <span class="cs-meta-label">Timeline</span><span
                  class="cs-meta-val">4 months</span
                >
              </div>
              <div class="cs-meta-item">
                <span class="cs-meta-label">Skills</span><span
                  class="cs-meta-val"
                  >Workflow audit, contextual inquiry, systems design,
                  feasibility, cross functional alignment</span
                >
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="cs-overview" class="cs-section cs-section--overview">
        <div class="cs-section__inner">
          <div class="cs-section__number">01<span>Overview</span></div>
          <div>
            <h2 class="cs-heading">A module with one button</h2>
            <p class="cs-body">
              Organizations on the product used forms to collect student data
              and generate official form outputs. An admin creates a form, a
              student fills it in, and the system generates an output from the
              responses.
            </p>
            <p class="cs-body">
              As the platform migrated from .NET to React, I was asked to
              modernize the output builder first, along with the entire form
              ecosystem. So I started with a workflow audit of the output setup.
              But the output module just had an option to upload a PDF. And
              nothing else.
            </p>
            <figure class="cs-figure">
              <img
                src={step4OutputEntry.src}
                width={step4OutputEntry.width}
                height={step4OutputEntry.height}
                alt="Legacy output entry screen, where the only option was to upload a PDF template"
                loading="lazy"
                decoding="async"
                data-lightbox-trigger
                style="cursor: pointer;"
              />
              <button
                type="button"
                class="cs-media-maximize"
                aria-label="Maximize image"
                title="Maximize image"
                data-lightbox-trigger
                set:html={fullscreenSvg}
              />
              <figcaption>The legacy output module.</figcaption>
            </figure>
            <p class="cs-body" style="margin-top:24px; margin-bottom:0">
              I usually find my way around new products easily, so this dead end
              surprised me. If I couldn't figure out the setup, a regular admin
              from an organization had no chance. So I sat with the engineers
              and watched them build an actual template. My first question to
              them was, why is PDF template is needed to create an output.
            </p>
          </div>
        </div>
      </section>

      <section id="cs-origin" class="cs-section cs-section--contrast">
        <div class="cs-section__inner">
          <div class="cs-section__number">02<span>Origin</span></div>
          <div>
            <h2 class="cs-heading">Why the PDF existed</h2>
            <p class="cs-body">
              That's when I understood it all. This was a legacy product built
              on .NET. When it was built, the engineers didn't have an option to
              create PDFs with the responses within the system. So they built an
              output builder module which will hold an output template to map
              the student respones and get their signatures.
            </p>
            <p class="cs-body">
              The system didn't know what to do with the output template. It
              didn't know which response went where. So the team added a unique
              response code for every possible response, and the engineers, when
              creating the PDF template, mapped these response codes to the
              correct field. Then, the system could easily replace the response
              codes in the template with the actual responses. Over the years,
              that became the only way outputs were made.
            </p>
            <section
              class="cs-flow-container"
              aria-label="Legacy output workflow"
              data-flow-carousel
            >
              <div
                class="cs-flow-tabs"
                role="tablist"
                aria-label="Workflow steps"
              >
                {
                  FLOW.map((f, i) => (
                    <button
                      class:list={["cs-flow-tab", { "is-active": i === 0 }]}
                      type="button"
                      role="tab"
                      id={`cs-flow-tab-${i}`}
                      aria-controls={`cs-flow-panel-${i}`}
                      aria-selected={i === 0 ? "true" : "false"}
                      tabindex={i === 0 ? "0" : "-1"}
                      data-flow-tab
                    >
                      <span
                        class="cs-flow-icon-wrap"
                        aria-hidden="true"
                        set:html={(FLOW_ICONS[i] ?? FLOW_ICONS[0]).replaceAll(
                          "clip_",
                          `clip${i}_`,
                        )}
                      />
                      <span class="cs-flow-tab__copy">
                        <span class="cs-flow-eyebrow">
                          Step {String(i + 1).padStart(2, "0")}
                        </span>
                        <span class="cs-flow-title">{f.title}</span>
                      </span>
                      <span class="cs-flow-tab__progress" aria-hidden="true" />
                    </button>
                  ))
                }
              </div>
              <div class="cs-flow-panels">
                {
                  FLOW.map((f, i) => (
                    <div
                      class:list={["cs-flow-panel", { "is-active": i === 0 }]}
                      id={`cs-flow-panel-${i}`}
                      role="tabpanel"
                      aria-labelledby={`cs-flow-tab-${i}`}
                      aria-describedby={`cs-flow-desc-${i}`}
                      hidden={i !== 0}
                      data-flow-panel
                    >
                      <p id={`cs-flow-desc-${i}`} class="cs-flow-status">
                        {f.desc}
                      </p>
                      <div class="cs-flow-panel__media">
                        <img
                          class="cs-flow-panel__image"
                          src={f.image.src}
                          width={f.image.width}
                          height={f.image.height}
                          alt={`${f.alt}. Step ${i + 1}: ${f.desc}`}
                          loading={i === 0 ? "eager" : "lazy"}
                          decoding="async"
                          data-lightbox-trigger
                          style="cursor: pointer;"
                        />
                        <button
                          type="button"
                          class="cs-media-maximize"
                          aria-label="Maximize image"
                          title="Maximize image"
                          data-lightbox-trigger
                          set:html={fullscreenSvg}
                        />
                      </div>
                    </div>
                  ))
                }
              </div>
              <p class="cs-flow-status" aria-live="polite">
                Showing step 1 of {FLOW.length}
              </p>
            </section>
          </div>
        </div>
      </section>

      <section id="cs-problem" class="cs-section cs-section--overview">
        <div class="cs-section__inner">
          <div class="cs-section__number">03<span>Problem</span></div>
          <div>
            <h2 class="cs-heading">Where the time went</h2>
            <p class="cs-body">
              Some forms had 50+ fields. Each question had multiple response
              codes to map. The common form below had 23 questions and 45 codes.
              Manually mapping them took most of an engineer's time, about 2 to
              3 days per template from starting till publishing.
            </p>
            <figure class="cs-figure">
              <img
                src={responsemapping.src}
                width={responsemapping.width}
                height={responsemapping.height}
                alt="Response mapping for one form: 23 questions expand into 45 response codes, since every possible response needs its own code"
                loading="lazy"
                decoding="async"
                data-lightbox-trigger
                style="cursor: pointer;"
              />
              <button
                type="button"
                class="cs-media-maximize"
                aria-label="Maximize image"
                title="Maximize image"
                data-lightbox-trigger
                set:html={fullscreenSvg}
              />
            </figure>
            <p class="cs-body" style="margin-top:24px">
              One mistake in the response code mapping could print a wrong
              response on an official document, like a student's enrollment form
              or distance learning contract. So they had to be diligent and slow
              to make everything right, and every template went through rounds
              of upload, test, and fix.
            </p>
            <p class="cs-body">
              The brief was to move PDF creation inside the system so engineers
              could build templates easily. But as I worked through it with the
              engineers, I found what was actually slowing them down.
            </p>
            <blockquote class="cs-blockquote">
              The PDF was never the problem. The response codes were.
            </blockquote>
            <p class="cs-body" style="margin-bottom:0">
              So I looked into options on how to make this workflow simple,
              instead of just creating a PDF editor inside the system.
            </p>
          </div>
        </div>
      </section>

      <section id="cs-constraint" class="cs-section cs-section--overview">
        <div class="cs-section__inner">
          <div class="cs-section__number">04<span>Constraint</span></div>
          <div>
            <h2 class="cs-heading">The idea we ruled out</h2>
            <p class="cs-body">
              I came from modernizing the staff dashboard with drag and drop
              custom widgets, so I immediately thought of a visual drag and drop
              WYSIWYG template builder. We had already built the tech, and it
              would be an easier port.
            </p>
            <p class="cs-body">
              But how do we map the response codes? The product's form creation
              and output modules were two independent modules, and the response
              codes were the only common thing among them.
            </p>
            <p class="cs-body" style="margin-bottom:0">
              At first I thought if we could rebuild the system for React, we
              could completely do away with response codes. We could directly
              show the form with user responses, like modern forms do, and
              generate the PDF using React PDF libraries. I checked with the
              devs and other stakeholders and found that it would take a lot of
              time to rebuild everything, and lots of changes would be required
              on the backend to make that happen. And that would affect all the
              orgs that use the legacy instances. So I went back to the drawing
              board.
            </p>
          </div>
        </div>
      </section>

      <section id="cs-datamodel" class="cs-section cs-section--overview">
        <div class="cs-section__inner">
          <div class="cs-section__number">05<span>Mapping Model</span></div>
          <div>
            <h2 class="cs-heading">Borrowing from clinical work</h2>
            <p class="cs-body">
              Suddenly I remembered how we turned voice transcription reports
              into EHR compatible JSON during my previous work on a clinical
              healthcare platform. That was my eureka moment. This was a similar
              problem. The response codes could become output builder compatible
              JSON.
            </p>
            <p class="cs-body">
              A PDF template held the layout and the mapping packed together. If
              those could live apart, the system could own the layout and the
              mapping could live as JSON. The response codes could stay as they
              were on the backend. I checked output templates built for several
              clients, and they all followed a simple layout. Only the response
              codes changed from one template to the next.
            </p>
            <div
              class="cs-datamodel-grid"
              style="--ink:#0f1524; --body:#253149; --soft:rgba(37,49,73,0.7); --muted:#5b6478; --line:rgba(79,70,229,0.16); --accent:#4f46e5; --accent-dim:#3730a3; --tint:rgba(79,70,229,0.06); --tint2:rgba(79,70,229,0.10); --red:#ef4444; --red-tint:rgba(239,68,68,0.06); --red-line:rgba(239,68,68,0.22); --mono:'IBM Plex Mono',Menlo,monospace; --serif:var(--font-title); --sans:var(--font); margin:32px 0 0; box-sizing:border-box; color:var(--body); font-family:var(--sans); display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:32px; align-items:start"
            >
              <!-- OLD WAY -->
              <div style="display:flex; flex-direction:column; gap:24px">
                <div
                  style="border:1px solid var(--red-line); border-radius:16px; background:#fef6f5; padding:24px; display:flex; flex-direction:column"
                >
                  <div
                    style="display:flex; align-items:center; justify-content:space-between; margin-bottom:28px"
                  >
                    <div
                      style="font-family:var(--mono); font-size:12px; letter-spacing:0.04em; text-transform:uppercase; color:var(--red); font-weight:500"
                    >
                      Before
                    </div>
                    <div
                      style="font-family:var(--mono); font-size:12px; color:var(--red); border:1px solid var(--red-line); border-radius:999px; padding:4px 12px"
                    >
                      Stored on upload
                    </div>
                  </div>

                  <!-- monolithic PDF -->
                  <div
                    style="position:relative; margin:0 auto 8px; width:100%; max-width:320px"
                  >
                    <div
                      style="position:absolute; inset:0; transform:translate(10px,10px); border:1px solid var(--red-line); border-radius:14px; background:#fff; opacity:0.5"
                    >
                    </div>
                    <div
                      style="position:absolute; inset:0; transform:translate(5px,5px); border:1px solid var(--red-line); border-radius:14px; background:#fff; opacity:0.75"
                    >
                    </div>
                    <div
                      style="position:relative; border:1px solid var(--red-line); border-radius:14px; background:#fff; padding:24px; box-shadow:0 12px 30px rgba(239,68,68,0.10)"
                    >
                      <div
                        style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px"
                      >
                        <div
                          style="font-family:var(--mono); font-size:12px; font-weight:600; color:var(--ink)"
                        >
                          AEL-Enrollment-template-final-v5.pdf
                        </div>
                      </div>
                      <!-- fused layers -->
                      <div
                        style="border:1px dashed var(--red-line); border-radius:8px; padding:20px; background:var(--red-tint); display:flex; flex-direction:column; gap:12px"
                      >
                        <div style="display:flex; align-items:center; gap:8px">
                          <span
                            style="width:8px; height:8px; border-radius:2px; background:var(--red)"
                          ></span>
                          <span
                            style="font-family:var(--mono); font-size:12px; color:var(--body)"
                            >Layout</span
                          >
                        </div>
                        <div
                          style="display:flex; flex-direction:column; gap:12px"
                        >
                          <div
                            style="height:6px; border-radius:3px; background:rgba(15,21,36,0.08)"
                          >
                          </div>
                          <div
                            style="height:6px; width:70%; border-radius:3px; background:rgba(15,21,36,0.08)"
                          >
                          </div>
